# copy to .env; never commit .env
AZURE_FOUNDRY_ENDPOINT=
AZURE_FOUNDRY_API_KEY=
AZURE_OPENAI_API_VERSION=2025-04-01-preview
MODEL_ROUTER_DEPLOYMENT=
MODEL_UI_DEPLOYMENT=
# optional: minimal | low | medium | high (leave empty for the deployment default)
MODEL_UI_REASONING_EFFORT=
# Which cartridge to serve; optional while only one is installed.
OBSIDIAN_CARTRIDGE=
# Local Postgres from compose.yaml; leave empty to keep everything in memory (lost on restart).
OBSIDIAN_DATABASE_URL=postgresql+asyncpg://obsidian:obsidian@localhost:5432/obsidian
# Any long random string; without it, a restart signs every browser back in as demo-user.
OBSIDIAN_SESSION_KEY=
